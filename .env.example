# Every variable the application reads. Copy to .env and fill in real values.
# Verified against the code with:
#   grep -rhoE "process\.env\.[A-Z_][A-Z0-9_]*" server/ scripts/ nuxt.config.ts | sort -u

# --- Postgres -----------------------------------------------------------------------
# The connection is built from these five. There is no DATABASE_URL: nothing reads one.
DATABASE_HOST=192.168.178.27
DATABASE_PORT=5432
DATABASE_NAME=plantz
DATABASE_USER=admin
DATABASE_PASSWORD=

# --- MinIO --------------------------------------------------------------------------
# Holds the plant photos. These are the only copy until OPS-01 lands.
MINIO_HOST=192.168.178.27
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=plantz
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- OpenRouter ---------------------------------------------------------------------
# Read server-side only, in server/api/plants/[id]/photos/[photoId]/analyze.post.ts.
# Do not put this under runtimeConfig.public in nuxt.config.ts: nuxt inlines that object
# into the client bundle and the key becomes readable by anyone who opens the app.
OPENROUTER_API_KEY=

# --- Build --------------------------------------------------------------------------
# Set by the CI pipeline as a docker build argument, reported as plantz_build_info.
# Defaults to "dev" when unset, so it is not needed for local development.
BUILD_TAG=dev
